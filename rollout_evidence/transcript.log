ut.y / 2.0)\n230\t\tinput.z = -raw_input.y * sqrt(1.0 - raw_input.x * raw_input.x / 2.0)\n231\t\n232\t\tinput = _camera_controller.global_transform.basis * input\n233\t\tinput.y = 0.0\n234\t\treturn input\n235\t\n236\t\n237\tfunc play_foot_step_sound() -> void:\n238\t\t_step_sound.pitch_scale = randfn(1.2, 0.2)\n239\t\t_step_sound.play()\n240\t\n241\t\n242\tfunc damage(_impact_point: Vector3, force: Vector3) -> void:\n243\t\t# Always throws character up\n244\t\tforce.y = abs(force.y)\n245\t\tvelocity = force.limit_length(max_throwback_force)\n246\t\tlose_coins()\n247\t\n248\t\n249\tfunc _orient_character_to_direction(direction: Vector3, delta: float) -> void:\n250\t\tvar left_axis := Vector3.UP.cross(direction)\n251\t\tvar rotation_basis := Basis(left_axis, Vector3.UP, direction).get_rotation_quaternion()\n252\t\tvar model_scale := _rotation_root.transform.basis.get_scale()\n253\t\t_rotation_root.transform.basis = Basis(_rotation_root.transform.basis.get_rotation_quaternion().slerp(rotation_basis, delta * rotation_speed)).scaled(\n254\t\t\tmodel_scale,\n255\t\t)\n256\t\n257\t\n258\t## Used to register required input actions when copying this character to a different project.\n259\tfunc _register_input_actions() -> void:\n260\t\tconst INPUT_ACTIONS := {\n261\t\t\t\"move_left\": KEY_A,\n262\t\t\t\"move_right\": KEY_D,\n263\t\t\t\"move_up\": KEY_W,\n264\t\t\t\"move_down\": KEY_S,\n265\t\t\t\"jump\": KEY_SPACE,\n266\t\t\t\"attack\": MOUSE_BUTTON_LEFT,\n267\t\t\t\"aim\": MOUSE_BUTTON_RIGHT,\n268\t\t\t\"swap_weapons\": KEY_TAB,\n269\t\t\t\"pause\": KEY_ESCAPE,\n270\t\t\t\"camera_left\": KEY_Q,\n271\t\t\t\"camera_right\": KEY_E,\n272\t\t\t\"camera_up\": KEY_R,\n273\t\t\t\"camera_down\": KEY_F,\n274\t\t}\n275\t\tfor action in INPUT_ACTIONS:\n276\t\t\tif InputMap.has_action(action):\n277\t\t\t\tcontinue\n278\t\t\tInputMap.add_action(action)\n279\t\t\tvar input_key = InputEventKey.new()\n280\t\t\tinput_key.keycode = INPUT_ACTIONS[action]\n281\t\t\tInputMap.action_add_event(ac