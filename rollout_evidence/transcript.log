{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QQJpxDTgfGmH4CZVvYgj3K","type":"tool_result","content":"1\tclass_name Player\n2\textends CharacterBody3D\n3\t\n4\tsignal weapon_switched(weapon_name: String)\n5\t\n6\tconst BULLET_SCENE := preload(\"bullet.tscn\")\n7\tconst COIN_SCENE := preload(\"coin/coin.tscn\")\n8\t\n9\tenum WEAPON_TYPE { DEFAULT, GRENADE }\n10\t\n11\t## Character maximum run speed on the ground.\n12\t@export var move_speed := 8.0\n13\t## Speed of shot bullets.\n14\t@export var bullet_speed := 10.0\n15\t## Forward impulse after a melee attack.\n16\t@export var attack_impulse := 10.0\n17\t## Movement acceleration (how fast character achieve maximum speed)\n18\t@export var acceleration := 4.0\n19\t## Jump impulse\n20\t@export var jump_initial_impulse := 12.0\n21\t## Jump impulse when player keeps pressing jump\n22\t@export var jump_additional_force := 4.5\n23\t## Player model rotation speed\n24\t@export var rotation_speed := 12.0\n25\t## Minimum horizontal speed on the ground. This controls when the character's animation tree changes\n26\t## between the idle and running states.\n27\t@export var stopping_speed := 1.0\n28\t## Max throwback force after player takes a hit\n29\t@export var max_throwback_force := 15.0\n30\t## Projectile cooldown\n31\t@export var shoot_cooldown := 0.5\n32\t## Grenade cooldown\n33\t@export var grenade_cooldown := 0.5\n34\t\n35\t@onready var _rotation_root: Node3D = $CharacterRotationRoot\n36\t@onready var _camera_controller: CameraController = $CameraController\n37\t@onready var _attack_animation_player: AnimationPlayer = $CharacterRotationRoot/MeleeAnchor/AnimationPlayer\n38\t@onready var _ground_shapecast: ShapeCast3D = $GroundShapeCast\n39\t@onready var _grenade_aim_controller: GrenadeLauncher = $GrenadeLauncher\n40\t@onready var _character_skin: CharacterSkin = $CharacterRotationRoot/CharacterSkin\n41\t@onready var _ui_aim_reticle: ColorRect = %AimReticle\n42\t@onready var _ui_coins_container: HBoxContainer = %CoinsContainer\n43\t@onready var _step_sound: AudioStreamPlayer3D = $StepSound\n44\t@onready var _landing_sound: AudioStreamPlayer3D = $LandingSound\n45\t\n46\t@onready var _equipped_weapon: WEAPON_TYPE = WEAPON_TYPE.DEFAULT\n47\t@onready var _move_direction := Vector3.ZERO\n48\t@onready var _last_strong_direction := Vector3.FORWARD\n49\t@onready var _gravity: float = -30.0\n50\t@onready var _ground_height: float = 0.0\n51\t@onready var _start_position := global_transform.origin\n52\t@onready var _coins := 0\n53\t@onready var _is_on_floor_buffer := false\n54\t\n55\t@onready var _shoot_cooldown_tick := shoot_cooldown\n56\t@onready var _grenade_cooldown_tick := grenade_cooldown\n57\t\n58\t\n59\tfunc _ready() -> void:\n60\t\tInput.mouse_mode = Input.MOUSE_MODE_CAPTURED\n61\t\t_camera_controller.setup(self)\n62\t\t_grenade_aim_controller.visible = false\n63\t\tweapon_switched.emit(WEAPON_TYPE.keys()[0])\n64\t\n65\t\t# When copying this character to a new project, the project may lack required input actions.\n66\t\t# In that case, we register input actions for the user at runtime.\n67\t\tif not InputMap.has_action(\"move_left\"):\n68\t\t\t_register_input_actions()\n69\t\n70\t\t_character_skin.stepped.connect(play_foot_step_sound)\n71\t\n72\t\n73\tfunc _physics_process(delta: float) -> void:\n74\t\t# Calculate ground height for camera controller\n75\t\tif _ground_shapecast.get_collision_count() > 0:\n76\t\t\tfor collision_result in _ground_shapecast.collision_result:\n77\t\t\t\t_ground_height = max(_ground_height, collision_result.point.y)\n78\t\telse:\n79\t\t\t_ground_height = global_position.y + _ground_shapecast.target_position.y\n80\t\tif global_position.y < _ground_height:\n81\t\t\t_ground_height = global_position.y\n82\t\n83\t\t# Swap weapons\n84\t\tif Input.is_action_just_pressed(\"swap_weapons\"):\n85\t\t\t_equipped_weapon = WEAPON_TYPE.DEFAULT if _equipped_weapon == WEAPON_TYPE.GRENADE else WEAPON_TYPE.GRENADE\n86\t\t\t_grenade_aim_controller.vis