n\t_player.velocity = Vector3(15, -5, 15)\n\t_pre_launch_velocity = _player.velocity\n\t_pad.body_entered.connect(func(b): print(\"BODY_ENTERED frame=\", _frame, \" body=\", b))\n\n\nfunc _physics_process(_delta: float) -> bool:\n\t_frame += 1\n\n\tvar mushroom: Node3D = _pad.get_node(\"mushroom\")\n\tif mushroom.scale.y < _mushroom_scale_min.y:\n\t\t_mushroom_scale_min = mushroom.scale\n\n\tprint(\"frame=\", _frame, \" player_y=\", _player.global_position.y, \" pad_y=\", _pad.global_position.y, \" overlapping=\", _pad.get_overlapping_bodies())\n\n\tif _frame == 30:\n\t\tprint(\"velocity_at_frame30=\", _player.velocity)\n\t\tprint(\"pre_launch_velocity=\", _pre_launch_velocity)\n\t\tprint(\"mushroom_scale_at_frame30=\", mushroom.scale)\n\n\tif _frame >= 90:\n\t\tprint(\"final_velocity=\", _player.velocity)\n\t\tprint(\"min_mushroom_scale_y=\", _mushroom_scale_min.y)\n\t\tprint(\"final_mushroom_scale=\", mushroom.scale)\n\t\tquit()\n\t\treturn true\n\n\treturn false\n","structuredPatch":[{"oldStart":26,"oldLines":7,"newStart":26,"newLines":14,"lines":["   _pre_launch_velocity = _player.velocity","   _pad.body_entered.connect(func(b): print(\"BODY_ENTERED frame=\", _frame, \" body=\", b))"," ","+  var col: CollisionShape3D = _pad.get_node(\"CollisionShape3D\")","+  print(\"pad collision_layer=\", _pad.collision_layer, \" mask=\", _pad.collision_mask, \" monitoring=\", _pad.monitoring)","+  print(\"col disabled=\", col.disabled, \" shape=\", col.shape, \" transform=\", col.transform)","+  print(\"player collision_layer=\", _player.collision_layer, \" mask=\", _player.collision_mask)","+  var pcol: CollisionShape3D = _player.get_node(\"CharacterCollisionShape\")","+  print(\"player col disabled=\", pcol.disabled, \" shape=\", pcol.shape, \" transform=\", pcol.transform)"," ","+"," func _physics_process(_delta: float) -> bool:","   _frame += 1"," "]}],"userModified":false,"replaceAll":false}}
