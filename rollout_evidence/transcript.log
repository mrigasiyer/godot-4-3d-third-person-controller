{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PWDD2oJxaFphukmKquGqx3","type":"tool_result","content":"1\tclass_name Player\n2\textends CharacterBody3D\n3\t\n4\tsignal weapon_switched(weapon_name: String)\n5\t\n6\tconst BULLET_SCENE := preload(\"bullet.tscn\")\n7\tconst COIN_SCENE := preload(\"coin/coin.tscn\")\n8\t\n9\tenum WEAPON_TYPE { DEFAULT, GRENADE }\n10\t\n11\t## Character maximum run speed on the ground.\n12\t@export var move_speed := 8.0\n13\t## Speed of shot bullets.\n14\t@export var bullet_speed := 10.0\n15\t## Forward impulse after a melee attack.\n16\t@export var attack_impulse := 10.0\n17\t## Movement acceleration (how fast character achieve maximum speed)\n18\t@export var acceleration := 4.0\n19\t## Jump impulse\n20\t@export var jump_initial_impulse := 12.0\n21\t## Jump impulse when player keeps pressing jump\n22\t@export var jump_additional_force := 4.5\n23\t## Player model rotation speed\n24\t@export var rotation_speed := 12.0\n25\t## Minimum horizontal speed on the ground. This controls when the character's animation tree changes\n26\t## between the idle and running states.\n27\t@export var stopping_speed := 1.0\n28\t## Max throwback force after player takes a hit\n29\t@export var max_throwback_force := 15.0\n30\t## Projectile cooldown\n31\t@export var shoot_cooldown := 0.5\n32\t## Grenade cooldown\n33\t@export var grenade_cooldown := 0.5\n34\t\n35\t@onready var _rotation_root: Node3D = $CharacterRotationRoot\n36\t@onready var _camera_controller: CameraController = $CameraController\n37\t@onready var _attack_animation_player: AnimationPlayer = $CharacterRotationRoot/MeleeAnchor/AnimationPlayer\n38\t@onready var _ground_shapecast: ShapeCast3D = $GroundShapeCast\n39\t@onready var _grenade_aim_controller: GrenadeLauncher = $GrenadeLauncher\n40\t@onready var _character_skin: CharacterSkin = $CharacterRotationRoot/CharacterSkin\n41\t@onready var _ui_aim_reticle: ColorRect = %AimReticle\n42\t@onready var _ui_coins_container: HBoxContainer = %CoinsContainer\n43\t@onready var _step_sound: AudioStreamPlayer3D = $StepSound\n44\t@onready var _landing_sound: AudioStreamPlayer3D = $LandingSound\n45\t\n46\t@onready var _equipped_weapon: WEAPON_TYPE = WEAPON_TYPE.DEFAULT\n47\t@onready var _move_direction := Vector3.ZERO\n48\t@onready var _last_strong_direction := Vector3.FORWARD\n49\t@onready var _gravity: float = -30.0\n50\t@onready var _ground_height: float = 0.0\n51\t@onready var _start_position := global_transform.origin\n52\t@onready var _coins := 0\n53\t@onready var _is_on_floor_buffer := false\n54\t\n55\t@onready var _shoot_cooldown_tick := shoot_cooldown\n56\t@onready var _grenade_cooldown_tick := grenade_cooldown\n57\t\n58\t\n59\tfunc _ready() -> void:\n60\t\tInput.mouse_mode = Input.MOUSE_MODE_CAPTURED\n61\t\t_camera_controller.setup(self)\n62\t\t_grenade_aim_controller.visible = false\n63\t\tweapon_switched.emit(WEAPON_TYPE.keys()[0])\n64\t\n65\t\t# When copying this character to a new project, the project may lack required input actions.\n66\t\t# In that case, we register input actions for the user at runtime.\n67\t\tif not InputMap.has_action(\"move_left\"):\n68\t\t\t_register_input_actions()\n69\t\n70\t\t_character_skin.stepped.connect(play_foot_step_sound)\n71\t\n72\t\n73\tfunc _physics_process(delta: float) -> void:\n74\t\t# Calculate ground height for camera controller\n75\t\tif _ground_shapecast.get_collision_count() > 0:\n76\t\t\tfor collision_result in _ground_shapecast.collision_result:\n77\t\t\t\t_ground_height = max(_ground_height, collision_result.point.y)\n78\t\telse:\n79\t\t\t_ground_height = global_position.y + _ground_shapecast.target_position.y\n80\t\tif global_position.y < _ground_height:\n81\t\t\t_ground_height = global_position.y\n82\t\n83\t\t# Swap weapons\n84\t\tif Input.is_action_just_pressed(\"swap_weapons\"):\n85\t\t\t_equipped_weapon = WEAPON_TYPE.DEFAULT if _equipped_weapon == WEAPON_TYPE.GRENADE else WEAPON_TYPE.GRENADE\n86\t\t\t_grenade_aim_controller.visible = _equipped_weapon == WEAPON_TYPE.GRENADE\n87\t\t\tweapon_switched.emit(WEAPON_TYPE.keys()[_equipped_weapon])\n88\t\n89\t\t# Get input and movement state\n90\t\tvar is_attacking := Input.is_action_pressed(\"attack\") and not _attack_animation_player.is_playing()\n91\t\tvar is_just_attacking := Input.is_action_just_pressed(\"attack\")\n92\t\tvar is_just_jumping := Input.is_action_just_pressed(\"jump\") and is_on_floor()\n93\t\tvar is_aiming := Input.is_action_pressed(\"aim\") and is_on_floor()\n94\t\tvar is_air_boosting := Input.is_action_pressed(\"jump\") and not is_on_floor() and velocity.y > 0.0\n95\t\tvar is_just_on_floor := is_on_floor() and not _is_on_floor_buffer\n96\t\n97\t\t_is_on_floor_buffer = is_on_floor()\n98\t\t_move_direction = _get_camera_oriented_input()\n99\t\n100\t\t# To not orient quickly to the last input, we save a last strong direction,\n101\t\t# this also ensures a good normalized value for the rotation basis.\n102\t\tif _move_direction.length() > 0.2:\n103\t\t\t_last_strong_direction = _move_direction.normalized()\n104\t\tif is_aiming:\n105\t\t\t_last_strong_direction = (_camera_controller.global_transform.basis * Vector3.BACK).normalized()\n106\t\n107\t\t_orient_character_to_direction(_last_strong_direction, delta)\n108\t\n109\t\t# We separate out the y velocity to not interpolate on the gravity\n110\t\tvar y_velocity := velocity.y\n111\t\tvelocity.y = 0.0\n112\t\tvelocity = velocity.lerp(_move_direction * move_speed, acceleration * delta)\n113\t\tif _move_direction.length() == 0 and velocity.length() < stopping_speed:\n114\t\t\tvelocity = Vector3.ZERO\n115\t\tvelocity.y = y_velocity\n116\t\n117\t\t# Set aiming camera and UI\n118\t\tif is_aiming:\n119\t\t\t_camera_controller.set_pivot(_camera_controller.CAMERA_PIVOT.OVER_SHOULDER)\n120\t\t\t_grenade_aim_controller.throw_direction = _camera_controller.camera.quaternion * Vector3.FORWARD\n121\t\t\t_grenade_aim_controller.from_look_position = _camera_controller.camera.global_position\n122\t\t\t_ui_aim_reticle.visible = true\n123\t\telse:\n124\t\t\t_camera_controller.set_pivot(_camera_controller.CAMERA_PIVOT.THIRD_PERSON)\n125\t\t\t_grenade_aim_controller.throw_direction = _last_strong_direction\n126\t\t\t_grenade_aim_controller.from_look_position = global_position\n127\t\t\t_ui_aim_reticle.visible = false\n128\t\n129\t\t# Update attack state and position\n130\t\n131\t\t_shoot_cooldown_tick += delta\n132\t\t_grenade_cooldown_tick += delta\n133\t\n134\t\tif is_attacking:\n135\t\t\tmatch _equipped_weapon:\n136\t\t\t\tWEAPON_TYPE.DEFAULT:\n137\t\t\t\t\tif is_aiming and is_on_floor():\n138\t\t\t\t\t\tif _shoot_cooldown_tick > shoot_cooldown:\n139\t\t\t\t\t\t\t_shoot_cooldown_tick = 0.0\n140\t\t\t\t\t\t\tshoot()\n141\t\t\t\t\telif is_just_attacking:\n142\t\t\t\t\t\tattack()\n143\t\t\t\tWEAPON_TYPE.GRENADE:\n144\t\t\t\t\tif _grenade_cooldown_tick > grenade_cooldown:\n145\t\t\t\t\t\t_grenade_cooldown_tick = 0.0\n146\t\t\t\t\t\t_grenade_aim_controller.throw_grenade()\n147\t\n148\t\tvelocity.y += _gravity * delta\n149\t\n150\t\tif is_just_jumping:\n151\t\t\tvelocity.y += jump_initial_impulse\n152\t\telif is_air_boosting:\n153\t\t\tvelocity.y += jump_additional_force * delta\n154\t\n155\t\t# Set character animation\n156\t\tif is_just_jumping:\n157\t\t\t_character_skin.jump()\n158\t\telif not is_on_floor() and velocity.y < 0:\n159\t\t\t_character_skin.fall()\n160\t\telif is_on_floor():\n161\t\t\tvar xz_velocity := Vector3(velocity.x, 0, velocity.z)\n162\t\t\tif xz_velocity.length() > stopping_speed:\n163\t\t\t\t_character_skin.set_moving(true)\n164\t\t\t\t_character_skin.set_moving_speed(inverse_lerp(0.0, move_speed, xz_velocity.length()))\n165\t\t\telse:\n166\t\t\t\t_character_skin.set_moving(false)\n167\t\n168\t\tif is_just_on_floor:\n169\t\t\t_landing_sound.play()\n170\t\n171\t\tvar position_before := global_position\n172\t\tmove_and_slide()\n173\t\tvar position_after := global_position\n174\t\n175\t\t# If velocity is not 0 but the difference of positions after move_and_slide is,\n176\t\t# character might be stuck somewhere!\n177\t\tvar delta_position := position_after - position_before\n178\t\tvar epsilon := 0.001\n179\t\tif delta_position.length() < epsilon and velocity.length() > epsilon:\n180\t\t\tglobal_position += get_wall_normal() * 0.1\n181\t\n182\t\n183\tfunc attack() -> void:\n184\t\t_attack_animation_player.play(\"Attack\")\n185\t\t_character_skin.punch()\n186\t\tvelocity = _rotation_root.transform.basis * Vector3.BACK * attack_impulse\n187\t\n188\t\n189\tfunc shoot() -> void:\n190\t\tvar bullet := BULLET_SCENE.instantiate()\n191\t\tbullet.shooter = self\n192\t\tvar origin := global_position + Vector3.UP\n193\t\tvar aim_target := _camera_controller.get_aim_target()\n194\t\tvar aim_direction := (aim_target - origin).normalized()\n195\t\tbullet.velocity = aim_direction * bullet_speed\n196\t\tbullet.distance_limit = 14.0\n197\t\tget_parent().add_child(bullet)\n198\t\tbullet.global_position = origin\n199\t\n200\t\n201\tfunc reset_position() -> void:\n202\t\ttransform.origin = _start_position\n203\t\n204\t\n205\tfunc collect_coin() -> void:\n206\t\t_coins += 1\n207\t\t_ui_coins_container.update_coins_amount(_coins)\n208\t\n209\t\n210\tfunc lose_coins() -> void:\n211\t\tvar lost_coins: int = min(_coins, 5)\n212\t\t_coins -= lost_coins\n213\t\tfor i in lost_coins:\n214\t\t\tvar coin := COIN_SCENE.instantiate()\n215\t\t\tget_parent().add_child(coin)\n216\t\t\tcoin.global_position = global_position\n217\t\t\tcoin.spawn(1.5)\n218\t\t_ui_coins_container.update_coins_amount(_coins)\n219\t\n220\t\n221\tfunc _get_camera_oriented_input() -> Vector3:\n222\t\tif _attack_animation_player.is_playing():\n223\t\t\treturn Vector3.ZERO\n224\t\n225\t\tvar raw_input := Input.get_vector(\"move_left\", \"move_right\", \"move_up\", \"move_down\")\n226\t\n227\t\tvar input := Vector3.ZERO\n228\t\t# This is to ensure that diagonal input isn't stronger than axis aligned input\n229\t\tinput.x = -raw_input.x * sqrt(1.0 - raw_input.y * raw_input.y / 2.0)\n230\t\tinput.z = -raw_input.y * sqrt(1.0 - raw_input.x * raw_input.x / 2.0)\n231\t\n232\t\tinput = _camera_controller.global_transform.basis * input\n233\t\tinput.y = 0.0\n234\t\treturn input\n235\t\n236\t\n237\tfunc play_foot_step_sound() -> void:\n238\t\t_step_sound.pitch_scale = randfn(1.2, 0.2)\n239\t\t_step_sound.play()\n240\t\n241\t\n242\tfunc damage(_impact_point: Vector3, force: Vector3) -> void:\n243\t\t# Always throws character up\n244\t\tforce.y = abs(force.y)\n245\t\tvelocity = force.limit_length(max_throwback_force)\n246\t\tlose_coins()\n247\t\n248\t\n249\tfunc _orient_character_to_direction(direction: Vector3, delta: float) -> void:\n250\t\tvar left_axis := Vector3.UP.cross(direction)\n251\t\tvar rotation_basis := Basis(left_axis, Vector3.UP, direction).get_rotation_quaternion()\n252\t\tvar model_scale := _rotation_root.transform.basis.get_scale()\n253\t\t_rotation_root.transform.basis = Basis(_rotation_root.transform.basis.get_rotation_quaternion().slerp(rotation_basis, delta * rotation_speed)).scaled(\n254\t\t\tmodel_scale,\n255\t\t)\n256\t\n257\t\n258\t## Used to register required input actions when copying this character to a different project.\n259\tfunc _register_input_actions() -> void:\n260\t\tconst INPUT_ACTIONS := {\n261\t\t\t\"move_left\": KEY_A,\n262\t\t\t\"move_right\": KEY_D,\n263\t\t\t\"move_up\": KEY_W,\n264\t\t\t\"move_down\": KEY_S,\n265\t\t\t\"jump\": KEY_SPACE,\n266\t\t\t\"attack\": MOUSE_BUTTON_LEFT,\n267\t\t\t\"aim\": MOUSE_BUTTON_RIGHT,\n268\t\t\t\"swap_weapons\": KEY_TAB,\n269\t\t\t\"pause\": KEY_ESCAPE,\n270\t\t\t\"camera_left\": KEY_Q,\n271\t\t\t\"camera_right\": KEY_E,\n272\t\t\t\"camera_up\": KEY_R,\n273\t\t\t\"camera_down\": KEY_F,\n274\t\t}\n275\t\tfor action in INPUT_ACTIONS:\n276\t\t\tif InputMap.has_action(action):\n277\t\t\t\tcontinue\n278\t\t\tInputMap.add_action(action)\n279\t\t\tvar input_key = InputEventKey.new()\n280\t\t\tinput_key.keycode = INPUT_ACTIONS[action]\n281\t\t\tInputMap.action_add_event(action, input_key)\n282\t"}]},"parent_tool_use_id":null,"session_id":"edfbf184-0857-4705-b334-06689a2545a2","uuid":"f7fe1569-8893-4a1f-86b9-8cb01469100a","timestamp":"2026-07-12T23:20:46.299Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/mrigas/rollouts/opus48-2/player/player.gd","content":"class_name Player\nextends CharacterBody3D\n\nsignal weapon_switched(weapon_name: String)\n\nconst BULLET_SCENE := preload(\"bullet.tscn\")\nconst COIN_SCENE := preload(\"coin/coin.tscn\")\n\nenum WEAPON_TYPE { DEFAULT, GRENADE }\n\n## Character maximum run speed on the ground.\n@export var move_speed := 8.0\n## Speed of shot bullets.\n@export var bullet_speed := 10.0\n## Forward impulse after a melee attack.\n@export var attack_impulse := 10.0\n## Movement acceleration (how fast character achieve maximum speed)\n@export var acceleration := 4.0\n## Jump impulse\n@export var jump_initial_impulse := 12.0\n## Jump impulse when player keeps pressing jump\n@export var jump_additional_force := 4.5\n## Player model rotation speed\n@export var rotation_speed := 12.0\n## Minimum horizontal speed on the ground. This controls when the character's animation tree changes\n## between the idle and running states.\n@export var stopping_speed := 1.0\n## Max throwback force after player takes a hit\n@export var max_throwback_force := 15.0\n## Projectile cooldown\n@export var shoot_cooldown := 0.5\n## Grenade cooldown\n@export var grenade_cooldown := 0.5\n\n@onready var _rotation_root: Node3D = $CharacterRotationRoot\n@onready var _camera_controller: CameraController = $CameraController\n@onready var _attack_animation_player: AnimationPlayer = $CharacterRotationRoot/MeleeAnchor/AnimationPlayer\n@onready var _ground_shapecast: ShapeCast3D = $GroundShapeCast\n@onready var _grenade_aim_controller: GrenadeLauncher = $GrenadeLauncher\n@onready var _character_skin: CharacterSkin = $CharacterRotationRoot/CharacterSkin\n@onready var _ui_aim_reticle: ColorRect = %AimReticle\n@onready var _ui_coins_container: HBoxContainer = %CoinsContainer\n@onready var _step_sound: AudioStreamPlayer3D = $StepSound\n@onready var _landing_sound: AudioStreamPlayer3D = $LandingSound\n\n@onready var _equipped_weapon: WEAPON_TYPE = WEAPON_TYPE.DEFAULT\n@onready var _move_direction := Vector3.ZERO\n@onready var _last_strong_direction := Vector3.FORWARD\n@onready var _gravity: float = -30.0\n@onready var _ground_height: float = 0.0\n@onready var _start_position := global_transform.origin\n@onready var _coins := 0\n@onready var _is_on_floor_buffer := false\n\n@onready var _shoot_cooldown_tick := shoot_cooldown\n@onready var _grenade_cooldown_tick := grenade_cooldown\n\n\nfunc _ready() -> void:\n\tInput.mouse_mode = Input.MOUSE_MODE_CAPTURED\n\t_camera_controller.setup(self)\n\t_grenade_aim_controller.visible = false\n\tweapon_switched.emit(WEAPON_TYPE.keys()[0])\n\n\t# When copying this character to a new project, the project may lack required input actions.\n\t# In that case, we register input actions for the user at runtime.\n\tif not InputMap.has_action(\"move_left\"):\n\t\t_register_input_actions()\n\n\t_character_skin.stepped.connect(play_foot_step_sound)\n\n\nfunc _physics_process(delta: float) -> void:\n\t# Calculate ground height for camera controller\n\tif _ground_shapecast.get_collision_count() > 0:\n\t\tfor collision_result in _ground_shapecast.collision_result:\n\t\t\t_ground_height = max(_ground_height, collision_result.point.y)\n\telse:\n\t\t_ground_height = global_position.y + _ground_shapecast.target_position.y\n\tif global_position.y < _ground_height:\n\t\t_ground_height = global_position.y\n\n\t# Swap weapons\n\tif Input.is_action_just_pressed(\"swap_weapons\"):\n\t\t_equipped_weapon = WEAPON_TYPE.DEFAULT if _equipped_weapon == WEAPON_TYPE.GRENADE else WEAPON_TYPE.GRENADE\n\t\t_grenade_aim_controller.visible = _equipped_weapon == WEAPON_TYPE.GRENADE\n\t\tweapon_switched.emit(WEAPON_TYPE.keys()[_equipped_weapon])\n\n\t# Get input and movement state\n\tvar is_attacking := Input.is_action_pressed(\"attack\") and not _attack_animation_player.is_playing()\n\tvar is_just_attacking := Input.is_action_just_pressed(\"attack\")\n\tvar is_just_jumping := Input.is_action_just_pressed(\"jump\") and is_on_floor()\n\tvar is_aiming := Input.is_action_pressed(\"aim\") and is_on_floor()\n\tvar is_air_boosting := Input.is_action_pressed(\"jump\") and not is_on_floor() and velocity.y > 0.0\n\tvar is_just_on_floor := is_on_floor() and not _is_on_floor_buffer\n\n\t_is_on_floor_buffer = is_on_floor()\n\t_move_direction = _get_camera_oriented_input()\n\n\t# To not orient quickly to the last input, we save a last strong direction,\n\t# this also ensures a good normalized value for the rotation basis.\n\tif _move_direction.length() > 0.2:\n\t\t_last_strong_direction = _move_direction.normalized()\n\tif is_aiming:\n\t\t_last_strong_direction = (_camera_controller.global_transform.basis * Vector3.BACK).normalized()\n\n\t_orient_character_to_direction(_last_strong_direction, delta)\n\n\t# We separate out the y velocity to not interpolate on the gravity\n\tvar y_velocity := velocity.y\n\tvelocity.y = 0.0\n\tvelocity = velocity.lerp(_move_direction * move_speed, acceleration * delta)\n\tif _move_direction.length() == 0 and velocity.length() < stopping_speed:\n\t\tvelocity = Vector3.ZERO\n\tvelocity.y = y_velocity\n\n\t# Set aiming camera and UI\n\tif is_aiming:\n\t\t_camera_controller.set_pivot(_camera_controller.CAMERA_PIVOT.OVER_SHOULDER)\n\t\t_grenade_aim_controller.throw_direction = _camera_controller.camera.quaternion * Vector3.FORWARD\n\t\t_grenade_aim_controller.from_look_position = _camera_controller.camera.global_position\n\t\t_ui_aim_reticle.visible = true\n\telse:\n\t\t_camera_controller.set_pivot(_camera_controller.CAMERA_PIVOT.THIRD_PERSON)\n\t\t_grenade_aim_controller.throw_direction = _last_strong_direction\n\t\t_grenade_aim_controller.from_look_position = global_position\n\t\t_ui_aim_reticle.visible = false\n\n\t# Update attack state and position\n\n\t_shoot_cooldown_tick += delta\n\t_grenade_cooldown_tick += delta\n\n\tif is_attacking:\n\t\tmatch _equipped_weapon:\n\t\t\tWEAPON_TYPE.DEFAULT:\n\t\t\t\tif is_aiming and is_on_floor():\n\t\t\t\t\tif _shoot_cooldown_tick > shoot_cooldown:\n\t\t\t\t\t\t_shoot_cooldown_tick = 0.0\n\t\t\t\t\t\tshoot()\n\t\t\t\telif is_just_attacking:\n\t\t\t\t\tattack()\n\t\t\tWEAPON_TYPE.GRENADE:\n\t\t\t\tif _grenade_cooldown_tick > grenade_cooldown:\n\t\t\t\t\t_grenade_cooldown_tick = 0.0\n\t\t\t\t\t_grenade_aim_controller.throw_grenade()\n\n\tvelocity.y += _gravity * delta\n\n\tif is_just_jumping:\n\t\tvelocity.y += jump_initial_impulse\n\telif is_air_boosting:\n\t\tvelocity.y += jump_additional_force * delta\n\n\t# Set character animation\n\tif is_just_jumping:\n\t\t_character_skin.jump()\n\telif not is_on_floor() and velocity.y < 0:\n\t\t_character_skin.fall()\n\telif is_on_floor():\n\t\tvar xz_velocity := Vector3(velocity.x, 0, velocity.z)\n\t\tif xz_velocity.length() > stopping_speed:\n\t\t\t_character_skin.set_moving(true)\n\t\t\t_character_skin.set_moving_speed(inverse_lerp(0.0, move_speed, xz_velocity.length()))\n\t\telse:\n\t\t\t_character_skin.set_moving(false)\n\n\tif is_just_on_floor:\n\t\t_landing_sound.play()\n\n\tvar position_before := global_position\n\tmove_and_slide()\n\tvar position_after := global_position\n\n\t# If velocity is not 0 but the difference of positions after move_and_slide is,\n\t# character might be stuck somewhere!\n\tvar delta_position := position_after - position_before\n\tvar epsilon := 0.001\n\tif delta_position.length() < epsilon and velocity.length() > epsilon:\n\t\tglobal_position += get_wall_normal() * 0.1\n\n\nfunc attack() -> void:\n\t_attack_animation_player.play(\"Attack\")\n\t_character_skin.punch()\n\tvelocity = _rotation_root.transform.basis * Vector3.BACK * attack_impulse\n\n\nfunc shoot() -> void:\n\tvar bullet := BULLET_SCENE.instantiate()\n\tbullet.shooter = self\n\tvar origin := global_position + Vector3.UP\n\tvar aim_target := _camera_controller.get_aim_target()\n\tvar aim_direction := (aim_target - origin).normalized()\n\tbullet.velocity = aim_direction * bullet_speed\n\tbullet.distance_limit = 14.0\n\tget_parent().add_child(bullet)\n\tbullet.global_position = origin\n\n\nfunc reset_position() -> void:\n\ttransform.origin = _start_position\n\n\nfunc collect_coin() -> void:\n\t_coins += 1\n\t_ui_coins_container.update_coins_amount(_coins)\n\n\nfunc lose_coins() -> void:\n\tvar lost_coins: int = min(_coins, 5)\n\t_coins -= lost_coins\n\tfor i in lost_coins:\n\t\tvar coin := COIN_SCENE.instantiate()\n\t\tget_parent().add_child(coin)\n\t\tcoin.global_position = global_position\n\t\tcoin.spawn(1.5)\n\t_ui_coins_container.update_coins_amount(_coins)\n\n\nfunc _get_camera_oriented_input() -> Vector3:\n\tif _attack_animation_player.is_playing():\n\t\treturn Vector3.ZERO\n\n\tvar raw_input := Input.get_vector(\"move_left\", \"move_right\", \"move_up\", \"move_down\")\n\n\tvar input := Vector3.ZERO\n\t# This is to ensure that diagonal input isn't stronger than axis aligned input\n\tinput.x = -raw_input.x * sqrt(1.0 - raw_input.y * raw_input.y / 2.0)\n\tinput.z = -raw_input.y * sqrt(1.0 - raw_input.x * raw_input.x / 2.0)\n\n\tinput = _camera_controller.global_transform.basis * input\n\tinput.y = 0.0\n\treturn input\n\n\nfunc play_foot_step_sound() -> void:\n\t_step_sound.pitch_scale = randfn(1.2, 0.2)\n\t_step_sound.play()\n\n\nfunc damage(_impact_point: Vector3, force: Vector3) -> void:\n\t# Always throws character up\n\tforce.y = abs(force.y)\n\tvelocity = force.limit_length(max_throwback_force)\n\tlose_coins()\n\n\nfunc _orient_character_to_direction(direction: Vector3, delta: float) -> void:\n\tvar left_axis := Vector3.UP.cross(direction)\n\tvar rotation_basis := Basis(left_axis, Vector3.UP, direction).get_rotation_quaternion()\n\tvar model_scale := _rotation_root.transform.basis.get_scale()\n\t_rotation_root.transform.basis = Basis(_rotation_root.transform.basis.get_rotation_quaternion().slerp(rotation_basis, delta * rotation_speed)).scaled(\n\t\tmodel_scale,\n\t)\n\n\n## Used to register required input actions when copying this character to a different project.\nfunc _register_input_actions() -> void:\n\tconst INPUT_ACTIONS := {\n\t\t\"move_left\": KEY_A,\n\t\t\"move_right\": KEY_D,\n\t\t\"move_up\": KEY_W,\n\t\t\"move_down\": KEY_S,\n\t\t\"jump\": KEY_SPACE,\n\t\t\"attack\": MOUSE_BUTTON_LEFT,\n\t\t\"aim\": MOUSE_BUTTON_RIGHT,\n\t\t\"swap_weapons\": KEY_TAB,\n\t\t\"pause\": KEY_ESCAPE,\n\t\t\"camera_left\": KEY_Q,\n\t\t\"camera_right\": KEY_E,\n\t\t\"camera_up\": KEY_R,\n\t\t\"camera_down\": KEY_F,\n\t}\n\tfor action in INPUT_ACTIONS:\n\t\tif InputMap.has_action(action):\n\t\t\tcontinue\n\t\tInputMap.add_action(action)\n\t\tvar input_key = InputEventKey.new()\n\t\tinput_key.keycode = INPUT_ACTIONS[action]\n\t\tInputMap.action_add_event(action, input_key)\n","numLines":282,"startLine":1,"totalLines":282}}}
